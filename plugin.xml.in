<pluginMetaData path="gitsync">
    <name>Git Sync</name>
    <author>Matthew Ratcliffe</author>
    <pluginVersion>@PLUGIN_VERSION@</pluginVersion>
    <!--
      Exact string match against the server version, split on commas. An
      extension declaring anything else is refused outright by ExtensionLoader
      and silently not loaded, so build.sh stamps this from MIRTH_VERSION.
    -->
    <mirthVersion>@MIRTH_VERSION@</mirthVersion>
    <url>https://openintegrationengine.org</url>
    <description>Synchronises channels, code templates, channel groups, the configuration map, alerts and global scripts with a git repository and branch. Pull on every instance; commit and push where enabled.</description>

    <serverClasses>
        <string>org.openintegrationengine.plugins.gitsync.GitSyncServicePlugin</string>
    </serverClasses>

    <library type="SERVER" path="libs/gitsync-server.jar" />
    <library type="SERVER" path="libs/org.eclipse.jgit-@JGIT_VERSION@.jar" />
    <library type="SERVER" path="libs/org.eclipse.jgit.ssh.jsch-@JGIT_VERSION@.jar" />
    <library type="SERVER" path="libs/JavaEWAH-1.2.3.jar" />
    <library type="SERVER" path="libs/slf4j-api-1.7.36.jar" />

    <apiProvider type="SERVLET_INTERFACE" name="org.openintegrationengine.plugins.gitsync.GitSyncServletInterface" />
    <apiProvider type="SERVER_CLASS" name="org.openintegrationengine.plugins.gitsync.GitSyncServlet" />
</pluginMetaData>
